# Copiar a .env.aurora y editar. Nunca subir .env.aurora a git.
# Template del entorno Aurora con TODOS los valores que espera la API.

# --- Base de datos (contenedor aurora-postgres17) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://aurora-postgres17:5432/aurora_pagos
SPRING_DATASOURCE_USERNAME=gestor_pagos
SPRING_DATASOURCE_PASSWORD=CAMBIAR_ESTA_PASSWORD
POSTGRES_DB=aurora_pagos
DB_SCHEMA=aurora_pagos

# --- Redis (contenedor aurora-redis) ---
REDIS_HOST=aurora-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- GestoPago ---
GESTOPAGO_AUTH_URL=https://gestopago.portalventas.net
GESTOPAGO_AUTH_ID_DISTRIBUIDOR=83
GESTOPAGO_AUTH_CODIGO_DISPOSITIVO=GPS83-TPV-17
GESTOPAGO_AUTH_PASSWORD=CAMBIAR
GESTOPAGO_UNIDAD=083
GESTOPAGO_CONFIRM_WAIT_SECONDS=62

# --- JWT (minimo 32 bytes para HS256) ---
JWT_SECRET=CAMBIAR_POR_UN_SEGURO_DE_AL_MENOS_64_CARACTERES_ALEATORIOS
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Admin inicial (se crea si no existe) ---
ADMIN_EMAIL=admin@prueba.com
ADMIN_PASSWORD=CAMBIAR
ADMIN_NOMBRE=Administrador

# --- CORS: origenes explicitos separados por coma, nunca * ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://100.91.46.42:3000

# --- Rate limiting ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# --- Cache del catalogo ---
CATALOGO_REDIS_KEY=catalogo:productos:activos

# --- Historial de pagos: Postgres es la fuente de verdad, Redis la lectura prioritaria ---
PAGOS_HISTORIAL_REDIS_ENABLED=true
PAGOS_HISTORIAL_REDIS_KEY=pagos:historial
PAGOS_HISTORIAL_REDIS_TTL_SECONDS=900
PAGOS_HISTORIAL_REDIS_MAX_ENTRADAS=50
